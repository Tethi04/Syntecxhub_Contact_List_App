<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Add New Contact 🌸"
        android:textColor="#1E293B"
        android:textSize="18sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etAddName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_glass_input"
        android:hint="Full Name"
        android:paddingHorizontal="14dp"
        android:textColor="#1E293B"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etAddPhone"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_glass_input"
        android:hint="Phone Number"
        android:inputType="phone"
        android:paddingHorizontal="14dp"
        android:textColor="#1E293B"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etAddEmail"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass_input"
        android:hint="Email Address"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="14dp"
        android:textColor="#1E293B"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelAdd"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#64748B" />

        <Button
            android:id="@+id/btnSaveContact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#C084FC"
            android:text="Save" />
    </LinearLayout>

</LinearLayout>
      
